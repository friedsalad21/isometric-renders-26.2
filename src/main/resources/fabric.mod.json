{
  "schemaVersion": 1,
  "id": "isometric-renders",
  "version": "${version}",
  "name": "Isometric Renders",
  "description": "Creates high-resolution renders of game objects (unofficial 26.2 port)",
  "authors": [
    "glisco"
  ],
  "contact": {
    "issues": "https://github.com/friedsalad21/isometric-renders-26.2/issues",
    "sources": "https://github.com/friedsalad21/isometric-renders-26.2"
  },
  "license": "MIT",
  "icon": "assets/isometric-renders/icon.png",
  "environment": "client",
  "accessWidener": "isometricrenders.accesswidener",
  "entrypoints": {
    "client": [
      "com.glisco.isometricrenders.IsometricRenders"
    ]
  },
  "mixins": [
    "isometric-renders.mixins.json"
  ],
  "breaks": {
    "optifabric": "*"
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "owo": ">=0.13"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/xrwHKktV2d"
      }
    }
  }
}